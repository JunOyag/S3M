// ---- BlockExchange.fbs ----
// Requêtes du protocole d'échange de blocs (protocols.echange-blocs) :
// Connecteur → Nœud, Nœud → partenaire, Connecteur ou nouveau Nœud →
// partenaire (secours). Protocole libp2p "/s3m/blocks/1".
// Source: protocols.echange-blocs (fonctionnalité ajoutée le 2026-11-20)
include "NodeMessage.fbs";
namespace S3m.Exchange;

// Autorisation de lecture de secours émise par un Nœud au profit d'une clé
// anonyme d'appareil. Sérialisée puis signée (SignedRescueGrant).
table RescueGrant {
  issuer_node_id: [ubyte];    // pub_node de l'émetteur (32 o)
  grant_pub: [ubyte];         // clé Ed25519 anonyme de l'appareil (32 o)
  expires_at: uint64;         // secondes Unix ; au plus 15 552 000 s après émission
  covered_node_ids: [ubyte];  // anciens node_id couverts par un pointeur de migration (n × 32 o)
}

// RescueGrant signé par priv_node de l'émetteur.
table SignedRescueGrant {
  grant: [ubyte];       // RescueGrant sérialisé
  signature: [ubyte];   // Ed25519 sur L("s3m/sig/rescue-grant/v1") ‖ grant
}

// Connecteur → son Nœud. Lien de session : identités Noise des deux pairs.
table UserCredential {
  user_id: [ubyte];     // pub_user (32 o), vu du seul Nœud sous Noise
  proof: [ubyte];       // KDF(K_attach, "connector-auth", —, peer_connecteur, peer_noeud)
}

// Connecteur → partenaire (Nœud injoignable).
table RescueCredential {
  grant: SignedRescueGrant;
  proof: [ubyte];       // Ed25519 par grant_priv sur L("s3m/sig/rescue-session/v1") ‖ L(peer_demandeur) ‖ L(peer_partenaire)
}

// Nouveau Nœud → partenaire de l'ancien Nœud, sur délégation du Connecteur.
table DelegatedCredential {
  grant: SignedRescueGrant;
  delegate_node_id: [ubyte];  // pub_node du nouveau Nœud (32 o)
  expires_at: uint64;         // au plus celui de l'autorisation
  signature: [ubyte];         // Ed25519 par grant_priv sur L("s3m/sig/rescue-delegation/v1") ‖ delegate_node_id ‖ u64be(expires_at)
}

// Ajout du 2026-11-21 (protocols.espace-secours) : Connecteur → partenaire de
// secours (Nœud injoignable). Preuve d'identité VDF de l'Utilisateur, liée à
// sa clé de secours et aux deux identités de la connexion.
table EmergencyCredential {
  sig_pub_user: [ubyte];      // identité VDF du User (32 o)
  vdf_y: [ubyte];
  vdf_pi: [ubyte];
  emergency_pub: [ubyte];     // sig_pub_emergency (32 o) : identifie le dépôt
  signature: [ubyte];         // Ed25519 par sig_priv_user sur L("s3m/sig/emergency-deposit/v1") ‖ emergency_pub ‖ L(peer_demandeur) ‖ L(peer_partenaire)
}

// Ajout du 2026-11-22 (protocols.partage) : autorisation de lecture des blocs
// d'un partage chez le Nœud du propriétaire. Sérialisée puis signée.
table ShareGrant {
  owner_user_id: [ubyte];     // pub_user du propriétaire (32 o), Utilisateur de ce Nœud
  node_id: [ubyte];           // pub_node du Nœud qui la sert (32 o)
  share_id: [ubyte];          // identifiant du partage (32 o)
  expires_at: uint64;         // secondes Unix ; 0 : sans expiration
}
// ShareGrant signé par priv_user du propriétaire.
table SignedShareGrant {
  grant: [ubyte];             // ShareGrant sérialisé
  signature: [ubyte];         // Ed25519 sur L("s3m/sig/share-grant/v1") ‖ grant
}
// N'importe quel Connecteur → Nœud du propriétaire : lecture (GetBlock) des
// blocs de ce propriétaire, débit limité.
table ShareCredential {
  grant: SignedShareGrant;
}

union Credential { UserCredential, RescueCredential, DelegatedCredential, EmergencyCredential, ShareCredential }

// Connecteur → Nœud
table GetBlock {
  hash: [ubyte];
}
// Connecteur → Nœud (bloc chiffré)
table PutBlock {
  data: [ubyte];
}
// Connecteur → Nœud
table CommitRoot {
  base_root: [ubyte];
  new_root: [ubyte];
  // Ajout du 2026-11-25 : descripteur scellé de new_root (crypto.k-self#k-root),
  // gardé par le Nœud sans pouvoir le lire ; vide : aucun (ancien Connecteur).
  root_seal: [ubyte];
}
// Connecteur → Nœud
table ReportIncident {
  hash: [ubyte];
}
// Connecteur → Nœud
table RenewGrant {
  grant_pub: [ubyte];
}
// Connecteur → nouveau Nœud
table Delegate {
  credential: DelegatedCredential;
}
// Nœud → partenaire
table StoreFragment {
  data: [ubyte];
}
// Nœud → partenaire (PoS)
table Challenge {
  hash: [ubyte];
  nonce: [ubyte];
}
// Nœud, Connecteur ou nouveau Nœud → partenaire
table FetchFragment {
  hash: [ubyte];
}
// Nœud → partenaire
table Tombstone {
  timestamp: uint64;
  hashes: [ubyte];
  signature: [ubyte];
}

// Ajouts du 2026-11-20 (protocols.partenariat-automatique) :
// N'importe quel pair → Nœud : mesure de disponibilité et de vitesse.
table Probe {
  nonce: [ubyte];
}
// Nœud → Nœud candidat : proposition de partenariat de troc 1:1.
table ProposePartnership {
  allowance_blocks: uint64;   // quota proposé (échange sur l'offre, 2026-11-24, node.PartnerAccount#quota)
  node_entry: [ubyte];        // entrée DHT Node du demandeur (enveloppe signée, preuve VDF)
}
// Connecteur → Nœud : rattachement automatique (credential UserCredential
// calculé avec le K_attach de ce sel).
table Attach {
  salt: [ubyte];              // sel d'attachement (16 o)
  sig_pub_user: [ubyte];      // identité VDF du User (32 o)
  vdf_y: [ubyte];
  vdf_pi: [ubyte];
  signature: [ubyte];         // Ed25519 par sig_priv_user sur L("s3m/sig/attach/v1") ‖ pub_user ‖ node_id
}

// Ajout du 2026-11-20 (protocols.gestion-volumes) : Nœud → partenaire,
// import d'un volume — « ces fragments sont-ils à vous, placés chez moi ? ».
table OwnershipQuery {
  hashes: [ubyte];            // SHA-256 concaténés (32 o chacun, 1024 au plus)
}

// Ajouts du 2026-11-21 (protocols.espace-secours).
// Connecteur → partenaire de secours (credential EmergencyCredential) :
// dépôt d'un bloc chiffré K_block.
table EmergencyPut {
  data: [ubyte];
}
// N'importe quel pair → partenaire de secours, sans credential : relecture
// d'un bloc déposé sous emergency_pub (Nœud de retour, autre Connecteur).
table EmergencyGet {
  emergency_pub: [ubyte];     // 32 o
  hash: [ubyte];              // 32 o
}
// N'importe quel pair → partenaire de secours, sans credential : libération
// après réconciliation, signée par la clé de secours.
table EmergencyRelease {
  emergency_pub: [ubyte];     // 32 o
  timestamp: uint64;          // strictement croissant par emergency_pub
  hashes: [ubyte];            // SHA-256 concaténés (32 o chacun, 1024 au plus)
  signature: [ubyte];         // Ed25519 par sig_priv_emergency sur L("s3m/sig/emergency-release/v1") ‖ emergency_pub ‖ u64be(timestamp) ‖ hashes
}

// Ajouts du 2026-11-21 (protocols.canal-noeud), Connecteur → son Nœud
// (UserCredential).
// Lecture des messages du Nœud de numéro > since (64 au plus, les plus anciens d'abord).
table ReadMessages {
  since_info: uint64;
  since_alert: uint64;
}
// Message de l'Utilisateur à son Nœud.
table PostMessage {
  text: string;               // UTF-8, 4 096 o au plus
}

// Ajout du 2026-11-22 (protocols.partage) : Connecteur → son Nœud
// (UserCredential) : retrait d'un partage, ses autorisations ne valent plus.
table RevokeShare {
  share_id: [ubyte];          // 32 o
}

// Ajout du 2026-11-23 (protocols.echange-blocs § Libération) : Connecteur →
// son Nœud (UserCredential) : blocs de l'Utilisateur qui ne servent plus
// (ancienne version, après un CommitRoot confirmé). Réponse : Ack.
table ReleaseBlocks {
  hashes: [ubyte];            // n × 32 o, 2 048 au plus
}

// Ajout du 2026-11-23 : Connecteur → son Nœud (UserCredential) : liste des
// blocs de l'Utilisateur encore comptés, par pages (rattrapage manuel).
// Réponse : BlockList.
table ListBlocks {
  after: [ubyte];             // dernier hash de la page précédente ; vide : début
  limit: uint32 = 2048;
}

// Ajouts du 2026-11-25 (protocols.historique-versions) : Connecteur → son
// Nœud (UserCredential). ListRoots → RootList ; PurgeRoots → Ack.
table ListRoots {
}
// Oublie les versions remplacées avant `before` (Unix) ; 0 : toutes.
table PurgeRoots {
  before: uint64;
}

// Ajout du 2026-11-25 (protocols.dispersion-transactionnelle#copie-locale) :
// Connecteur → son Nœud (UserCredential) : état de blocs de l'Utilisateur.
// Réponse : BlockStatusAnswer.
table BlockStatus {
  hashes: [ubyte];            // SHA-256 concaténés (32 o chacun, 2048 au plus)
}

// Ajout du 2026-11-25 (securite.incidents-compromissions#rotation-user) :
// Connecteur → son Nœud, sous l'identifiant de l'ANCIENNE identité : le
// compte (quota, racine, blocs, historique) passe à la nouvelle identité,
// l'ancienne est révoquée. Réponse : Ack.
table RotateUser {
  new_user_id: [ubyte];       // pub_user de la nouvelle identité
  new_salt: [ubyte];          // sel du nouvel attachement (16 o)
}

union RequestBody {
  GetBlock, PutBlock, CommitRoot, ReportIncident, RenewGrant, Delegate,
  StoreFragment, Challenge, FetchFragment, Tombstone,
  Probe, ProposePartnership, Attach, OwnershipQuery,
  EmergencyPut, EmergencyGet, EmergencyRelease,
  ReadMessages, PostMessage, RevokeShare,
  ReleaseBlocks, ListBlocks, ListRoots, PurgeRoots, BlockStatus, RotateUser
}

// Requête : une par flux libp2p request-response.
table BlockRequest {
  version: uint16 = 1;
  credential: Credential;     // absent entre Nœuds partenaires (identité Noise)
  body: RequestBody;
}

root_type BlockRequest;
file_identifier "BREQ";
