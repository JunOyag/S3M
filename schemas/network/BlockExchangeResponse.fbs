// ---- BlockExchangeResponse.fbs ----
// Réponses du protocole d'échange de blocs (protocols.echange-blocs).
// Source: protocols.echange-blocs (fonctionnalité ajoutée le 2026-11-20)
include "BlockExchange.fbs";
namespace S3m.Exchange;

enum ErrorCode : ubyte {
  NotFound = 0,        // bloc ou fragment absent
  Unauthorized = 1,    // identifiant absent, invalide, expiré ou révoqué
  QuotaExceeded = 2,   // quota du compte ou solde de troc dépassé
  TooLarge = 3,        // message au-delà de 1 048 576 o
  Malformed = 4,       // message illisible ou version inconnue
  RateLimited = 5,     // débit de secours dépassé
  Replayed = 6,        // avis de suppression non plus récent que le dernier appliqué
  Maintenance = 7      // Nœud en maintenance après la perte d'un volume (securite.integrite-autoreparation#maintenance)
}

table Failure {
  code: ErrorCode;
}
// GetBlock, FetchFragment, EmergencyGet
table BlockData {
  data: [ubyte];
}
// PutBlock, EmergencyPut
table Stored {
  hash: [ubyte];
}
// CommitRoot
table RootState {
  committed: bool;
  current_root: [ubyte];
  // Ajouts du 2026-11-21 (taille du lecteur, espace du Connecteur) ; 0 : non communiqué.
  quota_bytes: uint64;        // quota de l'Utilisateur
  used_bytes: uint64;         // octets occupés par ses blocs de données
  // Ajout du 2026-11-25 : descripteur scellé de current_root, tel que confié
  // par le Connecteur (crypto.k-self#k-root) ; vide : aucun.
  current_root_seal: [ubyte];
}
// StoreFragment
table FragmentReceipt {
  hash: [ubyte];
  signature: [ubyte];
}
// Challenge
table ChallengeResponse {
  digest: [ubyte];
}
// ReportIncident, Delegate, Tombstone, EmergencyRelease
table Ack {
  freed: uint64;
}
// RenewGrant
table GrantIssued {
  grant: SignedRescueGrant;
}

// Ajouts du 2026-11-20 (protocols.partenariat-automatique).
// Probe
table ProbeReply {
  nonce: [ubyte];
  accepting_partners: bool;   // accepte de nouvelles propositions
  node_name: string;          // ajout du 2026-11-22 (deploiement.pseudos) : nom actuel du Nœud, absent sans nom
}
// ProposePartnership
table PartnershipAnswer {
  granted_blocks: uint64;     // 0 : refusé ; sinon quota égal Q accordé (2026-11-24, node.PartnerAccount#quota)
}
// Attach
table Attached {
  quota_bytes: uint64;
  // Ajout du 2026-11-25 : Utilisateur déjà rattaché sous un autre sel (appareil
  // neuf sans entrée User) : sel enregistré, à reprendre ; vide sinon
  // (protocols.partenariat-automatique#sel-retrouve).
  salt: [ubyte];
}

// OwnershipQuery (ajout du 2026-11-20, protocols.gestion-volumes)
table OwnershipAnswer {
  owned: [ubyte];             // un bit par hash demandé, bit i%8 de l'octet i/8
}

// ReadMessages (ajout du 2026-11-21, protocols.canal-noeud)
table Messages {
  messages: [SignedNodeMessage];
  node_name: string;          // ajout du 2026-11-21 (deploiement.pseudos) : nom actuel du Nœud, absent sans nom
}

// ListBlocks (ajout du 2026-11-23) : une page, par hash croissant.
table BlockList {
  hashes: [ubyte];            // n × 32 o
  more: bool;                 // pages suivantes
}

union ResponseBody {
  Failure, BlockData, Stored, RootState, FragmentReceipt, ChallengeResponse,
  Ack, GrantIssued, ProbeReply, PartnershipAnswer, Attached, OwnershipAnswer,
  Messages, BlockList
}

table BlockResponse {
  version: uint16 = 1;
  body: ResponseBody;
}

root_type BlockResponse;
file_identifier "BRSP";
